[Unit]
Description=pct (paper collection tool) server
Documentation=https://github.com/MatchaChoco010/paper-collection-tool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@NODE@ @SERVER_ENTRY@
Restart=on-failure
RestartSec=5
# 変換と埋め込みの生成は dGPU で行う。ROCm は iGPU も 1 つのデバイスとして
# 列挙するため、明示的に dGPU へ固定しないとそちらへ載ることがある。
Environment=ROCR_VISIBLE_DEVICES=0
Environment=NODE_ENV=production
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pct

[Install]
WantedBy=default.target
