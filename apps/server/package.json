{
  "name": "@pct/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --disable-warning=ExperimentalWarning --experimental-strip-types src/main.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@hono/node-server": "^1.15.0",
    "hono": "^4.9.0",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.3"
  }
}
