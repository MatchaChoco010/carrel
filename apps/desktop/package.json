{
  "name": "@pct/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/waiting.html dist/waiting.html",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && electron dist/main.js",
    "package": "npm run build && electron-builder --linux",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.3"
  }
}
